# Entity: technology_detection

main: kit: entity: technology_detection: {

  alias: field: {}

  fields: {
    category: {
      h: "Category"
      n: "category"
      r: false
      sh: "Category of the technology (e.g., Framework, CMS, CDN, Analytics)"
      t: "`$STRING`"
    }
    confidence: {
      fo: "float"
      h: "Confidence"
      n: "confidence"
      r: false
      sh: "Confidence level of the detection (0-100)"
      t: "`$NUMBER`"
    }
    name: {
      h: "Name"
      n: "name"
      r: false
      sh: "Name of the detected technology"
      t: "`$STRING`"
    }
    version: {
      h: "Version"
      n: "version"
      r: false
      sh: "Version of the technology if detected"
      t: "`$STRING`"
    }
  }

  name: "technology_detection"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /api/techstack"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                ex: "https://example.com"
                k: "query"
                n: "url"
                or: "url"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/api/techstack"
          q: {
            exist: [
              "url"
            ]
          }
          s: [
            {
              lit: "api"
            }
            {
              lit: "techstack"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.technologies`"
          }
        }
      ]
    }
  }



}
